# Copy to `.env.local` (git-ignored) for local development. On Vercel these live
# in Project -> Settings -> Environment Variables; the Neon and Blob stores on
# the Storage tab add DATABASE_URL and BLOB_READ_WRITE_TOKEN for you.
#
# `vercel env pull .env.local` fetches the deployed values into this file.

# Password for /admin. Pick something long.
ADMIN_PASSWORD="change-me-before-you-open-the-shop"

# Optional. Signs the admin session cookie; defaults to ADMIN_PASSWORD.
# Set it so that changing the password does not invalidate live sessions.
# ADMIN_SESSION_SECRET=""

# Postgres connection string (Vercel -> Storage -> Neon).
DATABASE_URL=""

# Read/write token for the Blob store (Vercel -> Storage -> Blob).
BLOB_READ_WRITE_TOKEN=""
